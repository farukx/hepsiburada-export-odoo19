<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_hepsiburada" model="ir.ui.view">
        <field name="name">res.config.settings.view.hepsiburada</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     data-string="Hepsiburada"
                     string="Hepsiburada"
                     data-key="hepsiburada_export">
                    <h2>Hepsiburada API</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hb_username" string="Username"/>
                                <div class="text-muted">
                                    Hepsiburada API username
                                </div>
                                <div class="content-group mt8">
                                    <field name="hb_username" placeholder="your-username"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hb_password" string="Password"/>
                                <div class="text-muted">
                                    Hepsiburada API password
                                </div>
                                <div class="content-group mt8">
                                    <field name="hb_password"
                                           password="True"
                                           placeholder="••••••••"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hb_merchant_id" string="Merchant ID"/>
                                <div class="text-muted">
                                    Your Hepsiburada merchant UUID
                                </div>
                                <div class="content-group mt8">
                                    <field name="hb_merchant_id"
                                           placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="hb_endpoint_url" string="Import Endpoint URL"/>
                                <div class="text-muted">
                                    Hepsiburada product import endpoint
                                </div>
                                <div class="content-group mt8">
                                    <field name="hb_endpoint_url"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
